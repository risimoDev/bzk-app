[Unit]
Description=BZK Print Next.js Production Service
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/bzk-app

# Загрузка переменных окружения
EnvironmentFile=/opt/bzk-app/.env
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1

# Запуск standalone сервера Next.js
ExecStart=/usr/bin/node .next/standalone/server.js

# Автоматический перезапуск при сбоях
Restart=always
RestartSec=5s
KillMode=process

# Лимиты и безопасность
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/bzk-app/storage

# Логирование через systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bzk-app

[Install]
WantedBy=multi-user.target
