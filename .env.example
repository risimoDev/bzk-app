# ---------- База данных ----------
DATABASE_URL="postgresql://bzk:bzk@localhost:5434/bzk"

# Боевая MySQL - только для одноразовой миграции данных
LEGACY_MYSQL_URL="mysql://user:pass@host:3306/bzkprint"

# ---------- Аутентификация ----------
AUTH_SECRET=""            # openssl rand -base64 32
# Публичный адрес сайта - для карты сайта и абсолютных ссылок
SITE_URL="http://localhost:3000"
AUTH_URL="http://localhost:3000"

# Домен для Caddy: под него он получит сертификат Let's Encrypt
SITE_DOMAIN="bzkprint.ru"

# ---------- Почта ----------
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="БЗК Принт <bzkprint@yandex.ru>"

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=""
TELEGRAM_GROUP_CHAT_ID=""            # чат рабочей группы, куда дублируются уведомления
TELEGRAM_WEBHOOK_SECRET=""

# ---------- Банк Точка ----------
TOCHKA_API_URL=""
TOCHKA_TOKEN=""
TOCHKA_CUSTOMER_CODE=""

# ---------- Файлы ----------
UPLOAD_DIR="./storage/uploads"

# Cloudflare Turnstile (капча). Публичный ключ уходит в браузер, секрет - на сервере.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------- Планировщик ----------
# Секрет маршрута POST /api/cron/run: напоминания CRM, сроки задач, уборка
# журналов. Пустой - маршрут отвечает 404 и ничего не рассылается.
# Для проверки на своей машине: curl -X POST -H "Authorization: Bearer <секрет>" http://localhost:3000/api/cron/run
CRON_SECRET=""            # openssl rand -hex 32

# ---------- Реквизиты по ИНН (DaData) ----------
# Ключ API из личного кабинета dadata.ru (раздел «Поиск организаций»).
# Пустой - подсказки нет: кнопки «Заполнить по ИНН» не показываются,
# GET /api/suggestions/party отвечает 404. В репозиторий ключ не класть.
DADATA_API_KEY=""
