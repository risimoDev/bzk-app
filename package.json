    "check:cutting": "node --experimental-strip-types scripts/check-cutting.mjs",
    "check:num2words": "node --experimental-strip-types scripts/check-num2words.mjs",
    "check:uploads": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-uploads.mjs",
    "check:quality": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-quality.mjs",
    "check:telegram": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-telegram-link.mjs",
    "check:redirects": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-redirects.mjs",
    "check:rate-limit": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-rate-limit.mjs",
    "check:password-reset": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-password-reset.mjs",
    "check:totp": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-totp.mjs",
    "check:checkout": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-checkout.mjs",
    "check:documents": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-documents-access.mjs",
    "check:product-images": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-product-images.mjs",
    "check:price": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-price.mjs",
    "check:notify-format": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-notify-format.mjs",
    "check:document-templates": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-document-templates.mjs",
    "check:security": "node --experimental-strip-types --import ./scripts/alias-loader.mjs scripts/check-security.mjs",
    "verify-restore": "node scripts/verify-restore.mjs"
