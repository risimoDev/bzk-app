# ==============================================================================
# BZK PRINT - Шаблон переменных окружения для Production (Ubuntu VPS)
# ==============================================================================
# Использование:
#   cp .env.production.example .env
#   chmod 600 .env
#   nano .env
# ==============================================================================

# ---------- База данных PostgreSQL ----------
# Имя пользователя и базы данных (по умолчанию bzk)
POSTGRES_USER="bzk"
POSTGRES_DB="bzk"

# НАДЁЖНЫЙ ПАРОЛЬ БАЗЫ ДАННЫХ (сгенерируйте: openssl rand -base64 24)
POSTGRES_PASSWORD="CHANGE_ME_GENERATE_RANDOM_PASSWORD"

# Строка подключения для приложения.
# В Docker Compose имя хоста базы - 'db':
DATABASE_URL="postgresql://bzk:CHANGE_ME_GENERATE_RANDOM_PASSWORD@db:5432/bzk"

# (Опционально) Старая боевая MySQL - только для ОДНОКРАТНОГО переноса
# данных через служебный контейнер:
#   docker compose -f docker-compose.yml -f deploy/compose.tools.yml \
#     run --rm tools node scripts/migrate-data.mjs
# LEGACY_MYSQL_URL="mysql://user:password@old-host.ru:3306/bzkprint"

# ---------- Домен и Аутентификация ----------
# Домен: Caddy получит по нему SSL Let's Encrypt, и он же запекается
# в сборку для проверки Origin серверных действий (CSRF-защита)
SITE_DOMAIN="bzkprint.ru"

# Публичный канонический URL сайта (обязательно с https:// в проде)
SITE_URL="https://bzkprint.ru"
AUTH_URL="https://bzkprint.ru"

# Секретный ключ для сессий и шифрования Auth.js
# Сгенерируйте командой: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_GENERATE_WITH_OPENSSL"

# ---------- Почта (SMTP) ----------
# Используется для уведомлений и сброса паролей клиентов
SMTP_HOST="smtp.yandex.ru"
SMTP_PORT="465"
SMTP_USER="info@bzkprint.ru"
SMTP_PASS="YOUR_YANDEX_APP_PASSWORD"
SMTP_FROM="БЗК Принт <info@bzkprint.ru>"

# ---------- Telegram Бот ----------
# Токен бота от @BotFather для авторизации и уведомлений
TELEGRAM_BOT_TOKEN="123456789:ABCdefGHIjklMNOpqrsTUVwxyz"

# Секрет для защиты вебхука от спама (openssl rand -hex 16)
TELEGRAM_WEBHOOK_SECRET="CHANGE_ME_RANDOM_HEX_SECRET"

# ID группы/канала сотрудников для дублирования новых заявок и оплат (например: -100123456789)
TELEGRAM_GROUP_CHAT_ID=""

# ---------- Cloudflare Turnstile (капча на входе и регистрации) ----------
# Публичный ключ (data-sitekey) уходит в браузер, это не секрет.
# Секрет остаётся на сервере. Ключи берутся в дашборде Cloudflare Turnstile.
# Если оставить пустыми - капча просто не показывается.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------- Банк Точка (Интеграция с эквайрингом и выписками) ----------
TOCHKA_API_URL="https://enter.tochka.com/uapi"
TOCHKA_TOKEN=""
TOCHKA_CUSTOMER_CODE=""

# ---------- Файловое хранилище ----------
# Путь внутри контейнера приложения (не менять при работе через Docker Compose)
UPLOAD_DIR="/app/storage/uploads"

# ---------- Резервное копирование (Backup) ----------
# Срок хранения ежедневных дампов базы в днях (по умолчанию 14)
BACKUP_RETAIN_DAYS="14"
# Сколько дней хранить архивы загруженных файлов: они тяжелее дампа
BACKUP_UPLOADS_RETAIN_DAYS=7

# Время ночного запуска бэкапа (по времени контейнера Asia/Yekaterinburg, 3 = 03:00 ночи)
BACKUP_HOUR="3"

# ---------- Планировщик (контейнер cron) ----------
# Секрет маршрута POST /api/cron/run: по нему контейнер cron раз в пять
# минут зовёт приложение (напоминания CRM, сроки задач, уборка журналов).
# Пустой - маршрут отвечает 404, напоминания не рассылаются, deploy.sh
# предупредит. Сгенерируйте: openssl rand -hex 32
# (hex, а не base64: в значении не должно быть символов, которые путает shell)
CRON_SECRET=""
# Пауза между вызовами, секунд (по умолчанию 300)
# CRON_INTERVAL="300"

# ---------- Реквизиты по ИНН (DaData) ----------
# Ключ API с dadata.ru (раздел «Поиск организаций»): в формах профиля
# клиента, контрагента и подрядчика появляется кнопка «Заполнить по ИНН».
# Пустой - кнопки нет, подсказка выключена. Ключ секретный, как пароль.
DADATA_API_KEY=""
