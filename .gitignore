# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# Публичный корневой сертификат Минцифры для Точка Банка: нужен в репозитории,
# иначе после git pull на сервере его не будет и образ не соберётся
!deploy/certs/*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Шаблоны без секретов - нужны в репозитории: по ним заполняют .env
# (README.md, DEPLOY.md, first-install.sh). Настоящие значения - только в .env
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
assets-src/

*.tmp

# Дампы для переноса на прод - не коммитим (в них данные)
transfer/

# Настройки rclone для выгрузки бэкапов вне сервера - в них ключи доступа
/rclone.conf
