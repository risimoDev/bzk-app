# Замените на боевой домен - Caddy сам получит сертификат Let's Encrypt.
{$SITE_DOMAIN:localhost} {
	encode zstd gzip

	# Загрузки клиентов намеренно НЕ раздаются статикой:
	# макеты и документы приватные, их отдаёт приложение
	# после проверки прав.
	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	log {
		# Явная ротация: без неё лог в томе caddy_data растёт до
		# встроенного предела Caddy, и сколько его копится - неочевидно
		output file /data/access.log {
			roll_size 50MiB
			roll_keep 10
		}
		# Ссылка из письма сброса пароля несёт одноразовый токен в query
		# (?token=…). В логе он пролежал бы до ротации, и любой, кто
		# прочитает лог, успел бы сменить пароль. Токен вырезаем из адреса
		# запроса и из Referer: страница сброса шлёт свой полный адрес
		# заголовком Referer со всех последующих запросов (политика
		# strict-origin-when-cross-origin режет его только для чужих
		# сайтов). Куки и Authorization - сессии и ключи - не пишем вовсе
		format filter {
			wrap json
			fields {
				request>uri query {
					delete token
				}
				request>headers>Referer query {
					delete token
				}
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}

# www ведёт на тот же адрес, что и голый домен, и уже разрешается в тот же
# IP: без этого блока после переключения www.bzkprint.ru остался бы без
# сертификата и перестал открываться. Сам сайт живёт на одном адресе,
# поэтому здесь только постоянный редирект.
www.{$SITE_DOMAIN:localhost} {
	redir https://{$SITE_DOMAIN:localhost}{uri} permanent
}
